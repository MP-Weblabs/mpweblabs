# Copia este archivo a .env.local y rellena los valores.

# Clave de acceso de Web3Forms (https://web3forms.com) — los leads llegan al email con el que se crea.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Token de integración interna de Notion (https://www.notion.so/profile/integrations)
# La integración debe tener acceso a la base de datos "Leads · Pipeline de ventas".
NOTION_API_KEY=

# Analítica con cookies: solo se carga si el visitante acepta el banner.
# Vacías = sin banner y sin GA4/Clarity (solo Vercel Analytics, sin cookies).
# GA4 → Administrar → Flujos de datos → ID de medición (G-XXXXXXX)
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity → Settings → Overview → Project ID
NEXT_PUBLIC_CLARITY_ID=
